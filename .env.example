# Firebase Web App configuration (copy to .env.local and use your own project values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Defaults to us-central1 when omitted.
VITE_FIREBASE_FUNCTIONS_REGION=

# Optional local-development Emulator Suite switch. Never enabled in production.
VITE_USE_FIREBASE_EMULATOR=false
