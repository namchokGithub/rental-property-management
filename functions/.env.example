# Backend-only configuration. Do not use VITE_* frontend variables here.
# Must match the region selected for the deployed v2 HTTP function.
FUNCTIONS_REGION=asia-southeast1

# Comma-separated browser origins for future authenticated API requests.
# Leave empty for unrestricted local development (emulator or plain `node` scripts).
# In a real deployment (Cloud Run sets K_SERVICE there), the function refuses to start unless this is set explicitly.
CORS_ALLOWED_ORIGINS=
